# ---- The two things that broke the old setup ----------------------------
# steam_game_reviews.csv is ~475 MB. GitHub hard-rejects any file over 100 MB,
# and the dashboard never reads it at runtime — only generate_exports.py does.
# Keep it locally, next to this repo; it stays out of version control.
steam_game_reviews.csv

